    { "base": "settings-remaining-states", "label": "Settings · remaining states", "group": "Coverage still open", "state": "withheld", "reason": "Other committed menu choices and panes longer than one viewport apart from Shortcuts remain uncaptured. Shortcut scroll extents do not prove all nested paint bounds." },
    { "base": "portal-surfaces", "label": "Command / Find / Downloads / Peek", "group": "Coverage still open", "state": "withheld", "reason": "Captured: the Command Palette's empty query, actions with/without matches, a typed address and a plain search; Find open, first and second match and no match; the Downloads panel empty, with finished/failed history and with a missing file; Peek's bar over a loaded preview. Uncaptured: Command Palette tab, history and Saved Page result mixes and committed actions, Find previous/wrap and navigation outcomes, running and paused Downloads rows with their actions, Peek loading/crashed/back-forward states. Peek page pixels are native and excluded. The original pilot's transparent fade is retained as failed evidence. Hidden child-frame renderer evidence does not prove native on-screen visibility or WebKit composition; no reconstructed pixels." },
    { "base": "permission-surfaces", "label": "Permissions and native dialogs", "group": "Coverage still open", "state": "withheld", "reason": "Captured: the camera and microphone prompt, site settings with a blocked camera, the client-certificate sheet, the open-in-app sheet and no-app banner, the HTTP Basic credential sheet and the populated Privacy lists. Uncaptured: location, notification and other capability prompts, the in-use device marks in the address, the pop-up notice, a credential retry after a wrong password, and macOS's own dialogs (native, excluded)." },
    { "base": "welcome-about", "label": "Welcome, import and About", "group": "Coverage still open", "state": "withheld", "reason": "Import with an unreadable or missing browser and the About window's update half (no update channel yet) remain uncaptured; Make Default asks macOS, whose dialog is native and excluded." },
