{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPUI Visual agent response envelope (not a review or acceptance seal)",
  "type": "object",
  "required": ["schema", "tool_version", "command", "status", "exit_code", "data", "error"],
  "properties": {
    "schema": {"const": 1},
    "tool_version": {"type": "string"},
    "command": {"type": "string"},
    "status": {"enum": ["ok", "review_required", "invalid"]},
    "exit_code": {"enum": [0, 1, 2]},
    "timings_ms": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "data": {"description": "Command-specific result; null on early failure, attempted paths may be retained on execution failure. Consumers must tolerate additive fields."},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["code", "message", "next_step"], "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "next_step": {"type": "string"}
        }}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"exit_code": {"const": 2}}}, "then": {"properties": {"status": {"const": "invalid"}, "error": {"type": "object"}}}},
    {"if": {"properties": {"exit_code": {"const": 1}}}, "then": {"properties": {"status": {"const": "review_required"}, "error": {"type": "null"}}}},
    {"if": {"properties": {"exit_code": {"const": 0}}}, "then": {"properties": {"status": {"const": "ok"}, "error": {"type": "null"}}}}
  ]
}
